<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<artifactId>de.metas.parent</artifactId>
		<groupId>de.metas</groupId>
		<version>10.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>de.metas.migration</groupId>
	<artifactId>de.metas.migration</artifactId>
	<packaging>pom</packaging>

	<properties>
		<!-- Keep in sync with the slf4j-2.x line managed by the spring-boot 3.5.x BOM / de.metas.parent.general.
		     de.metas.migration.cli is a shaded uber-jar that embeds slf4j-api + logback; a stale 1.7.x api here
		     bundles an slf4j-1.x LoggerFactory that, next to the modern logback (a ServiceLoader provider, no
		     StaticLoggerBinder), falls back to a NOP logger and breaks Spring Boot's LogbackLoggingSystem when
		     the jar is on the cucumber/server classpath. -->
		<slf4j.version>2.0.18</slf4j.version>
	</properties>

	<modules>
		<module>de.metas.migration.base</module>
		<module>de.metas.migration.cli</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.slf4j</groupId>
				<artifactId>slf4j-api</artifactId>
				<version>${slf4j.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<scope>provided</scope>
		</dependency>
	</dependencies>

</project>