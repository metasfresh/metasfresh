<?xml version="1.0" encoding="UTF-8"?>
<!--
  Font family definitions for the metasfresh invoice report family.

  Purpose: PDF/A-3 compliance for ZUGFeRD e-invoicing.
  PDF/A-3 requires all fonts to be embedded. The invoice JRXMLs use three
  family names — "Arial", "SansSerif", and "OCRB" — which must each resolve
  with pdfEmbedded=true.

  Arial / SansSerif → Liberation Sans (metrics-compatible, SIL Open Font License)
  OCRB              → OCR-B TTF (from jp.osdn.ocrb, GPL), overriding the
                      jp.osdn.ocrb-0.2.1.jar registration that ships pdfEmbedded=false.

  The Liberation Sans TTFs are bundled here from /usr/share/fonts/truetype/liberation/
  (SIL Open Font License 1.1). The OCRB.ttf is bundled from the jp.osdn.ocrb jar
  (GPL v2+).
-->
<fontFamilies>

    <!--
      Arial → Liberation Sans.
      The invoice JRXMLs use fontName="Arial" throughout. Arial is proprietary and
      cannot be legally embedded; Liberation Sans is metrics-compatible and open-licensed.
    -->
    <fontFamily name="Arial">
        <normal><![CDATA[fonts/invoice/LiberationSans/LiberationSans-Regular.ttf]]></normal>
        <bold><![CDATA[fonts/invoice/LiberationSans/LiberationSans-Bold.ttf]]></bold>
        <italic><![CDATA[fonts/invoice/LiberationSans/LiberationSans-Italic.ttf]]></italic>
        <boldItalic><![CDATA[fonts/invoice/LiberationSans/LiberationSans-BoldItalic.ttf]]></boldItalic>
        <pdfEncoding><![CDATA[Cp1252]]></pdfEncoding>
        <pdfEmbedded><![CDATA[true]]></pdfEmbedded>
    </fontFamily>

    <!--
      SansSerif → Liberation Sans.
      The invoice JRXMLs use fontName="SansSerif" for some fields (a logical/system
      family name that is not embeddable on its own).
    -->
    <fontFamily name="SansSerif">
        <normal><![CDATA[fonts/invoice/LiberationSans/LiberationSans-Regular.ttf]]></normal>
        <bold><![CDATA[fonts/invoice/LiberationSans/LiberationSans-Bold.ttf]]></bold>
        <italic><![CDATA[fonts/invoice/LiberationSans/LiberationSans-Italic.ttf]]></italic>
        <boldItalic><![CDATA[fonts/invoice/LiberationSans/LiberationSans-BoldItalic.ttf]]></boldItalic>
        <pdfEncoding><![CDATA[Cp1252]]></pdfEncoding>
        <pdfEmbedded><![CDATA[true]]></pdfEmbedded>
    </fontFamily>

    <!--
      OCRB → OCR-B TTF.
      The invoice ESR / QR payment slip JRXMLs use fontName="OCRB" for the codeline.
      The jp.osdn.ocrb-0.2.1.jar (which is not a direct dependency of this module but
      may be present at runtime) registers OCRB with pdfEmbedded=false. This entry
      overrides that registration with pdfEmbedded=true so the codeline font is
      embedded in PDF/A-3 output.
    -->
    <fontFamily name="OCRB">
        <normal><![CDATA[fonts/invoice/OCRB.ttf]]></normal>
        <pdfEncoding><![CDATA[Cp1252]]></pdfEncoding>
        <pdfEmbedded><![CDATA[true]]></pdfEmbedded>
    </fontFamily>

</fontFamilies>
