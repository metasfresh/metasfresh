<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="report" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="812" leftMargin="15" rightMargin="15" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail" resourceBundle="de/metas/reports/product_statistics_year_comparison/report" uuid="db33bdcd-3d7c-4de5-9e1e-01292a7f6869">
	<property name="ireport.encoding" value="UTF-8"/>
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="metasfresh"/>
	<import value="net.sf.jasperreports.engine.*"/>
	<import value="java.util.*"/>
	<parameter name="AD_Org_ID" class="java.math.BigDecimal"/>
	<parameter name="C_Year_ID" class="java.math.BigDecimal"/>
	<parameter name="M_Product_ID" class="java.math.BigDecimal"/>
	<parameter name="M_Product_To_ID" class="java.math.BigDecimal"/>
	<parameter name="M_Product_Category_ID" class="java.math.BigDecimal"/>
	<!-- login context key of the printing user (see Jasper parameter map), resolved to the user name in the query -->
	<parameter name="#AD_User_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[-- one header row from the parameters (also when the function returns no rows), the function's rows joined to it
SELECT f.*, h.*
FROM (SELECT (SELECT o.Name FROM AD_Org o WHERE o.AD_Org_ID = $P{AD_Org_ID}) AS Hdr_OrgName,
             (SELECT y.FiscalYear FROM C_Year y WHERE y.C_Year_ID = $P{C_Year_ID}) AS Hdr_FiscalYear,
             (SELECT c.ISO_Code
              FROM AD_Org o
                       JOIN C_AcctSchema acs ON acs.C_AcctSchema_ID = getC_AcctSchema_ID(o.AD_Client_ID, o.AD_Org_ID)
                       JOIN C_Currency c ON c.C_Currency_ID = acs.C_Currency_ID
              WHERE o.AD_Org_ID = $P{AD_Org_ID}) AS Hdr_Currency,
             -- one product: value and name; a range: the lower and the higher value (text order, as the report sorts)
             (SELECT CASE
                         WHEN COUNT(*) = 1 THEN MIN(p.Value || ' ' || p.Name)
                         WHEN COUNT(*) = 2 THEN MIN(p.Value) || ' … ' || MAX(p.Value)
                     END
              FROM M_Product p WHERE p.M_Product_ID IN ($P{M_Product_ID}, $P{M_Product_To_ID})) AS ParamProduct,
             (SELECT pc.Name FROM M_Product_Category pc WHERE pc.M_Product_Category_ID = $P{M_Product_Category_ID}) AS ParamProductCategory,
             (SELECT u.Name FROM AD_User u WHERE u.AD_User_ID = NULLIF($P{#AD_User_ID}, '')::numeric) AS PrintUser) h
         LEFT JOIN report.Product_Statistics_Year_Comparison($P{AD_Org_ID}, $P{C_Year_ID}, $P{M_Product_ID}, $P{M_Product_To_ID}, $P{M_Product_Category_ID}) f ON TRUE
ORDER BY f.ProductValue]]>
	</queryString>
