			<!-- BALANCE row -->
			<textField>
				<reportElement x="0" y="0" width="410" height="14">
					<printWhenExpression><![CDATA["BALANCE".equals($F{report_level})]]></printWhenExpression>
				</reportElement>
				<box><topPen lineWidth="0.5"/></box>
				<textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$R{balance}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0.00;-#,##0.00" isBlankWhenNull="true">
				<reportElement x="410" y="0" width="125" height="14">
					<printWhenExpression><![CDATA["BALANCE".equals($F{report_level})]]></printWhenExpression>
				</reportElement>
				<box><topPen lineWidth="0.5"/></box>
				<textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
				<textFieldExpression><![CDATA[$F{balance_amt}]]></textFieldExpression>
			</textField>
			<!-- DETAIL row -->
			<textField pattern="dd.MM.yyyy" isBlankWhenNull="true">
				<reportElement x="0" y="0" width="50" height="14">
					<printWhenExpression><![CDATA["DETAIL".equals($F{report_level})]]></printWhenExpression>
				</reportElement>
				<textElement verticalAlignment="Middle"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{posting_date}]]></textFieldExpression>
			</textField>
			<textField isBlankWhenNull="true">
				<reportElement x="50" y="0" width="70" height="14">
					<printWhenExpression><![CDATA["DETAIL".equals($F{report_level})]]></printWhenExpression>
				</reportElement>
				<textElement verticalAlignment="Middle"><font size="7"/></textElement>
				<textFieldExpression><![CDATA[$F{documentno}]]></textFieldExpression>
