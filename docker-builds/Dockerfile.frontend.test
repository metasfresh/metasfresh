FROM node:18 AS build

RUN apt-get update && apt-get install -y locales && rm -rf /var/lib/apt/lists/* && localedef -i de_DE -c -f UTF-8 -A /usr/share/locale/locale.alias de_DE.UTF-8
ENV LANG=de_DE.UTF-8 LANGUAGE=de_DE.UTF-8 LC_MESSAGES=de_DE.UTF-8
ENV TZ=Europe/Berlin

WORKDIR /app

#
# Install required packages
# NOTE: copy the bare minimum config files at this point to favor caching
COPY e2e/frontend-webui/package.json* .
COPY e2e/frontend-webui/package-lock.json* .
RUN npm ci

# Install Playwright browsers with dependencies
RUN npx playwright install --with-deps chromium

#
# Copy the rest of our source files (i.e. the tests)
COPY e2e/frontend-webui/ .

COPY docker-builds/e2e-tests/playwright-run-shard.js /playwright-run-shard.js

#
# Start command. Without PLAYWRIGHT_SHARD: runs all tests.
# With PLAYWRIGHT_SHARD=<i>/<n> (e.g. 2/6): runs this shard's spec files, balanced by the measured
# durations in shard-durations.json (see docker-builds/e2e-tests/playwright-run-shard.js).
CMD ["node", "/playwright-run-shard.js", "shard-durations.json", "node_modules/.bin/playwright", "test"]
