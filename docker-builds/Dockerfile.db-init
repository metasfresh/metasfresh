FROM postgres:15.4

RUN apt-get update && apt-get install -y mmv && rm -rf /var/lib/apt/lists/*

ENV POSTGRES_USER=postgres
ENV POSTGRES_PASSWORD=postgres
ENV LC_ALL="en_US.UTF-8"
ENV LC_CTYPE="en_US.UTF-8"

# thx to https://stackoverflow.com/a/48311129/1012103
RUN echo en_US.UTF-8 UTF-8 > /etc/locale.gen && locale-gen en_US.UTF-8

COPY docker-builds/db/init/ /docker-entrypoint-initdb.d/

# COPY docker-builds/db/metasfresh_latest.pgdump .
# The seed: a pg_dump of a green cicd run's preloaded DB of THIS branch, built by .github/workflows/db-seed.yaml.
# cicd (step check-db-seed) fails if its commit is not in the history of the commit being built.
# Refresh it from time to time (run db-seed, then update this tag): the older the seed, the more scripts each build applies.
COPY --from=metasfresh/metas-db:5.175-new-dawn-uat.45675-seed --chown=postgres /metasfresh.pgdump metasfresh.pgdump
