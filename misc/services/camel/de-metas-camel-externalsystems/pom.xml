<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.metas.camel</groupId>
        <artifactId>de-metas-camel</artifactId>
        <version>10.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <groupId>de.metas.camel.externalsystems</groupId>
    <artifactId>de-metas-camel-externalsystems</artifactId>
    <version>10.0.0</version>
    <packaging>pom</packaging>

    <properties>
        <java.version>17</java.version>
        <spring-boot.version>3.4.3</spring-boot.version>
        <!-- java25: Spring Framework 6.2.3 (bundled by Spring Boot 3.4.3) ships an ASM too old to
             read Java-25 bytecode (class-file major 69) -> ClassFormatException while scanning the
             metasfresh-common classes. Pin Spring Framework to 6.2.19 (ASM 9.8, reads class 69) via
             an earlier BOM import, WITHOUT bumping Spring Boot itself: Camel 4.10.6 is built against
             Spring Boot 3.4.x (SB 3.5 removed MultipartProperties.getEnabled(), which camel-servlet's
             ServletMappingAutoConfiguration calls), so the autoconfigure layer must stay on 3.4.3. -->
        <spring-framework.version>6.2.19</spring-framework.version>
        <camel.version>4.10.6</camel.version>
        <guava.version>33.4.5-jre</guava.version>

        <assertj.version>3.27.3</assertj.version>
        <metasfresh-common.version>10.0.0</metasfresh-common.version>
        <jackson.version>2.18.3</jackson.version>
    </properties>
    
    <modules>
        <module>core</module>
        <module>alberta</module>
        <module>common</module>
        <module>de-metas-camel-grssignum</module>
        <module>de-metas-camel-leichundmehl</module>
        <module>de-metas-camel-pcm-file-import</module>
        <module>de-metas-camel-printingclient</module>
        <module>de-metas-camel-rabbitmq</module>
        <module>de-metas-camel-scriptedadapter</module>
        <module>de-metas-camel-shopware6</module>
        <module>de-metas-camel-woocommerce</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- java25: imported BEFORE spring-boot-dependencies so these Spring Framework versions
                 win over the ones the Spring Boot 3.4.3 BOM would otherwise manage. -->
            <dependency>
                <groupId>org.springframework</groupId>
                <artifactId>spring-framework-bom</artifactId>
                <version>${spring-framework.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.apache.camel</groupId>
                <artifactId>camel-bom</artifactId>
                <version>${camel.version}</version>
                <scope>import</scope>
                <type>pom</type>
            </dependency>

            <!-- java25: Mockito (5.14.2, pulled by spring-boot-starter-test / camel-test) ships
                 Byte Buddy 1.15.11, which rejects Java-25 bytecode (class 69) -> the alberta route
                 tests fail with "Java 25 (69) is not supported by the current version of Byte Buddy".
                 Pin Byte Buddy 1.17.8 (reads class 69), the same version the main backend bumped to
                 for Mockito-on-JDK25; overrides the version managed by the Spring Boot BOM. -->
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy</artifactId>
                <version>1.17.8</version>
            </dependency>
            <dependency>
                <groupId>net.bytebuddy</groupId>
                <artifactId>byte-buddy-agent</artifactId>
                <version>1.17.8</version>
            </dependency>

            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>

            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <dependencies>
        <dependency>
            <!-- we include lombok in the actual build, as curtesy to 3rd-parties who want to compile against this build's image -->
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.24</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- needed to run the tests with maven's surefire-plugin -->
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
