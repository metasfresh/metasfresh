<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>de.metas.parent.general</artifactId>
        <groupId>de.metas</groupId>
        <version>10.0.0</version>
        <relativePath>../parent-pom/pom.xml</relativePath>
    </parent>

    <groupId>de.metas.common</groupId>
    <artifactId>de-metas-common</artifactId>

    <!-- FRESH-271: we need an explicit version here, otherwise versions-maven-plugin
        can't set it to another version -->
    <version>10.0.0</version>

    <packaging>pom</packaging>

    <modules>
        <module>de-metas-common-bpartner</module>
        <module>de-metas-common-changelog</module>
        <module>de-metas-common-externalreference</module>
        <module>de-metas-common-externalsystem</module>
        <module>de-metas-common-filemaker</module>
        <module>de-metas-common-manufacturing</module>
        <module>de-metas-common-procurement</module>
        <module>de-metas-common-rest_api</module>
        <module>de-metas-common-shipping</module>
        <module>de-metas-common-util</module>
        <module>de-metas-common-product</module>
        <module>de-metas-common-pricing</module>
        <module>de-metas-common-ordercandidates</module>
        <module>de-metas-common-delivery</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- In de-metas-common we have no spring, so we use junit's own BOM to set the versions -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>5.12.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    
    <dependencies>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- needed to run the tests with maven's surefire-plugin -->
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- OpenAPI 3 annotations (io.swagger.v3.oas.annotations.*), framework-agnostic (annotations only),
             replacing springfox 3.0.0 which is javax.servlet-only and breaks on Spring Boot 3.
             Version matches the swagger-core line springdoc 2.8.x brings into the backend. -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
            <version>2.2.47</version>
        </dependency>

        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>${jackson.version}</version>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>17.0.0</version>
        </dependency>
    </dependencies>
    
    <build>
        <plugins>
            <plugin>
                <!-- These are pure JSON DTO / value libraries: NO Spring beans live here (no
                     @Configuration/@Component/@Service), so the parent's `-parameters` arg (added
                     for Spring 6.1 constructor bean-by-name) serves no purpose here. Worse, with
                     Jackson 2.18 (Spring Boot 3) `-parameters` makes jackson-module-parameter-names
                     expose the constructor parameter name as the SOLE deserialization name, dropping
                     it as an alias: a @Value DTO whose @JsonCreator param carries @JsonProperty("x")
                     but whose Lombok getter serializes as the field name "y" then round-trips as
                     write "y" / read-accepts-only "x" -> the field silently deserializes to null (or
                     fails @NonNull). Before the JDK 25 migration (no -parameters) Jackson accepted
                     BOTH the @JsonProperty name and the getter/field name, so these DTOs round-tripped.
                     Drop -parameters here (keep -Xpkginfo:always) to restore that behaviour for all
                     de-metas-common DTOs; annotationProcessorPaths (Lombok) and source/target are
                     inherited unchanged from the parent. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs combine.children="override">
                        <arg>-Xpkginfo:always</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>

            <plugin>
                <!--
                It would be nice to skip just the dependencyConvergence rule, but i don't know how to do that.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>